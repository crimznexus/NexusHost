@echo off
rem Generated by NexusHost setup-server.ps1. Run setup again to update the paths below.
title __TITLE__
cd /d "%~dp0"

set "JAVA=__JAVA__"
set "JAR=__JAR__"
set "MEM=__MEM__"
set "FLAGS=__FLAGS__"

:loop
"%JAVA%" -Xms%MEM% -Xmx%MEM% %FLAGS% -jar "%JAR%" --nogui
if %ERRORLEVEL% EQU 0 (
  echo Server stopped normally.
  pause
  exit /b 0
)
echo Server crashed with exit code %ERRORLEVEL%. Restarting in 10 seconds. Press Ctrl+C to cancel.
timeout /t 10
goto loop
